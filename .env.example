# ============================================================
# BIMA Dashboard - PostgreSQL
# cp .env.example .env  lalu sesuaikan
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bima_db
DB_USER=postgres
DB_PASSWORD=isi_password_postgres_anda

PORT=3002
NODE_ENV=development
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# Storage: local (default) atau minio
MEDIA_DISK=local
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=us-east-1

# JWT
JWT_SECRET=ganti_dengan_random_string_panjang
JWT_EXPIRES=8h

# Akun admin pertama (dibuat saat db:init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@bima.local
